{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Dashboard",
  "version": "0.2.1",
  "identifier": "dev.sessiondashboard.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Session Dashboard",
        "width": 1440,
        "height": 920,
        "center": true,
        "visible": false,
        "label": "main",
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run and supervise many Claude Code sessions at once",
    "longDescription": "A desktop app for running many Claude Code sessions in parallel: it finds every session on your machine, shows which ones need you, and lets you answer, review and switch between them.",
    "homepage": "https://github.com/shamilbasarov/SessionDashboard",
    "copyright": "shamilbasarov",
    "publisher": "shamilbasarov"
  }
}
